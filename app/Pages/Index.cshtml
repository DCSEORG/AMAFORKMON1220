@page
@model IndexModel
@{
    ViewData["Title"] = "Expense Management System";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .error-banner {
            background: #ff4444;
            color: white;
            padding: 15px 20px;
            margin-bottom: 20px;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }

        .error-banner h3 {
            margin-bottom: 8px;
            font-size: 18px;
        }

        .error-banner p {
            font-size: 14px;
            line-height: 1.6;
        }

        .error-location {
            margin-top: 8px;
            font-size: 12px;
            opacity: 0.9;
            font-style: italic;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
        }

        .header {
            background: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 8px 16px rgba(0,0,0,0.1);
            margin-bottom: 30px;
        }

        h1 {
            color: #333;
            font-size: 32px;
            margin-bottom: 10px;
        }

        .subtitle {
            color: #666;
            font-size: 16px;
        }

        .card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 8px 16px rgba(0,0,0,0.1);
            padding: 30px;
        }

        .table-container {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        thead {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        th {
            padding: 15px;
            text-align: left;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 12px;
            letter-spacing: 0.5px;
        }

        td {
            padding: 15px;
            border-bottom: 1px solid #eee;
        }

        tr:hover {
            background: #f8f9fa;
        }

        .status-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .status-pending {
            background: #fff3cd;
            color: #856404;
        }

        .status-approved {
            background: #d4edda;
            color: #155724;
        }

        .status-rejected {
            background: #f8d7da;
            color: #721c24;
        }

        .amount {
            font-weight: 600;
            color: #667eea;
        }

        .nav-links {
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid #eee;
        }

        .nav-links a {
            color: #667eea;
            text-decoration: none;
            margin-right: 20px;
            font-weight: 500;
        }

        .nav-links a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <div class="container">
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="error-banner">
                <h3>⚠️ Database Connection Error</h3>
                <p>@Model.ErrorMessage</p>
                @if (!string.IsNullOrEmpty(Model.ErrorLocation))
                {
                    <p class="error-location">Location: @Model.ErrorLocation</p>
                }
                <p style="margin-top: 10px; font-weight: bold;">Displaying dummy data for demonstration purposes.</p>
            </div>
        }

        <div class="header">
            <h1>💰 Expense Management System</h1>
            <p class="subtitle">Modern cloud-native expense tracking solution</p>
        </div>

        <div class="card">
            <h2 style="margin-bottom: 20px; color: #333;">Recent Expenses</h2>
            
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Employee</th>
                            <th>Category</th>
                            <th>Amount</th>
                            <th>Description</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Manager</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var expense in Model.Expenses)
                        {
                            <tr>
                                <td>@expense.ExpenseId</td>
                                <td>@expense.UserName</td>
                                <td>@expense.CategoryName</td>
                                <td class="amount">£@expense.Amount.ToString("N2")</td>
                                <td>@expense.Description</td>
                                <td>@expense.ExpenseDate.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="status-badge status-@(expense.StatusName?.ToLower())">
                                        @expense.StatusName
                                    </span>
                                </td>
                                <td>@(expense.ManagerName ?? "N/A")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="nav-links">
                <a href="/api-docs">📄 API Documentation</a>
                <a href="/Chat">💬 Chat Assistant</a>
            </div>
        </div>
    </div>
</body>
</html>
